# Copia este archivo como .env y completa los valores.
# El .env es personal de cada equipo y no se sube al repositorio.

# Clave secreta de Django. Genera una propia con:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY='cambia-esta-clave'
DEBUG=True
# Dominios separados por coma; en desarrollo puede quedar vacío
ALLOWED_HOSTS=

# MySQL
DB_NAME=adapt_academy
DB_USER=root
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=3306
